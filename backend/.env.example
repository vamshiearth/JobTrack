DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=jobtrack_db
DB_USER=jobtrack_user
DB_PASSWORD=replace-with-your-local-password

# Google sign-in - configure in a later step
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# Gmail OAuth - not enabled yet
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/gmail/callback
GMAIL_OAUTH_SCOPE=https://www.googleapis.com/auth/gmail.metadata
GMAIL_TOKEN_ENCRYPTION_KEYS=
GMAIL_INITIAL_SYNC_LIMIT=100
GMAIL_SYNC_ENABLED=false

AUTH_FRONTEND_URL=http://localhost:5173
AUTH_COOKIE_NAME=jobtrack_session
AUTH_SESSION_DAYS=7
AUTH_OAUTH_TRANSACTION_MINUTES=10
AUTH_COOKIE_SECURE=false
